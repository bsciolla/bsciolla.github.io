---
layout: base.njk
---

<h1>Blog Posts</h1>

{% for post in collections.posts %}
  <article class="post-summary">
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <time datetime="{{ post.date | dateDisplay }}">{{ post.date | dateDisplay }}</time>
    {% if post.data.excerpt %}
      <p>{{ post.data.excerpt }}</p>
    {% endif %}
  </article>
{% endfor %}
